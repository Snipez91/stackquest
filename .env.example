# ---------------------------------------------------------------------------
# StackQuest configuration. Copy to .env.local for development.
# No paid AI or third-party API keys are required.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Leave unset in local development to use the
# embedded PGlite database stored in .data/pglite (real Postgres, no install).
# Production: required (e.g. Render, Neon, Supabase, RDS).
# DATABASE_URL=postgres://user:password@host:5432/stackquest

# TLS to Postgres: on by default for non-localhost hosts.
#   DATABASE_SSL=false            disable TLS (only for private networks)
#   DATABASE_SSL_STRICT=true      verify the server certificate (recommended if your provider supports it)
# DATABASE_POOL_MAX=10

# Run migrations automatically on first DB connection (default true).
# Set to false if you run `npm run db:migrate` as a release step instead.
# AUTO_MIGRATE=true

# Public base URL, used to build invitation links. Required in production.
# APP_URL=https://stackquest.example.com

# Seed a clearly labelled fictional demo team and enable "Explore the demo".
# Never enable on a deployment your team uses for real data.
DEMO_MODE=false

# Local dev only: override where PGlite stores data ("memory" for ephemeral).
# PGLITE_DIR=.data/pglite
