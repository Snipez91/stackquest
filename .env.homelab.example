# StackQuest self-hosted settings. ./start.sh copies this to .env on first run
# and fills in POSTGRES_PASSWORD. Edit .env, not this file.

# The address people type in their browser. Invitation links are built from it.
#   https://learn.example.com      Cloudflare Tunnel, Caddy or another HTTPS proxy
#   https://box.tailnet.ts.net     Tailscale Funnel
#   http://192.168.1.50:3000       LAN testing only (sign-in cookies are not Secure)
APP_URL=

# Database password. Generated by ./start.sh. Postgres only reads it the first
# time the database is created, so don't change it afterwards.
POSTGRES_PASSWORD=

# Host port and interface for the app. Use 127.0.0.1 if only a proxy on this
# machine (Caddy, Tailscale) should reach it; the Cloudflare Tunnel container
# doesn't need the host port at all.
PORT=3000
BIND_ADDRESS=0.0.0.0

# first-only: only the first account can create a team; everyone else joins
#             with an invitation link (recommended for a public server).
# open:       anyone who signs up can create their own team.
TEAM_CREATION=first-only

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → create → Docker).
# When set, ./start.sh also starts the tunnel. Point the tunnel's public
# hostname at http://app:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# How many days of nightly database backups to keep in ./backups.
BACKUP_KEEP_DAYS=14

# Fictional demo team. Leave false on a server your team really uses.
DEMO_MODE=false
